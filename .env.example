# Copy to .env.local for development; set the same in Vercel for production.
# See docs/SETUP.md for how to obtain each value.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=            # 32 bytes base64: openssl rand -base64 32
JOBS_SECRET=                     # shared secret for /api/jobs/*: openssl rand -hex 32
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # transcription only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_TOKEN=                    # internal integration
GRANOLA_API_KEY=                 # only if Business plan; otherwise MCP OAuth tokens live in connected_accounts
VAPID_PUBLIC_KEY=                # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joshxnyc@gmail.com
PUSHOVER_USER_KEY=               # optional fallback
PUSHOVER_APP_TOKEN=              # optional fallback
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York
